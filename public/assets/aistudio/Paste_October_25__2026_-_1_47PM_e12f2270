<script>

(()=>{

'use strict';

const $=id=>document.getElementById(id);

const LANES=[-3.25,0,3.25],R=.36;

let scene,camera,renderer,ball,ballTrail=[],roads=[],buildings=[],lamps=[],palms=[],waves=[],coins=[],enemies=[],powerUps=[];

let running=false,paused=false,gameOver=false,soundOn=true,tiltOn=false;

let score=0,coinCount=0,best=0,distance=0,speed=13,targetX=0,jumpVelocity=0;

let jumping=false,airJumpUsed=false,landingBounce=0,leftHeld=false,rightHeld=false,lastTime=0;

let pointerStart=null,lastPointerX=0,audioCtx=null,musicTimer=null,musicStep=0,musicBeat=0;

let lives=3,damageCooldown=0,invulnerable=0,recoveryMessageTime=0;

let shieldActive=false,shieldTime=0,speedBoostTime=0,magnetTime=0;

let tiltBaseline=null,orientationSeen=false,orientationTimeout=null,scoreSubmitted=false,scoreSaving=false;

const SUPABASE_URL="https://frpsinogtxzhmrrttdpp.supabase.co";

const SUPABASE_KEY="sb_publishable_XrKxDWWTcH1Eb4eYLFl5Ug_jg4fCrtu";

const LEADERBOARD_TABLE="leaderboard";

const db=window.supabase?.createClient(SUPABASE_URL,SUPABASE_KEY);

const avatars=["🦁","🦊","🐺","🐯","🦅","🐉","🦈","🐼","🦝","🐸"];

/* Save the name and SCORE. Hide the name box only after the server confirms success. */

async function saveScoreToLeaderboard(finalScore){

 if(scoreSubmitted||scoreSaving)return;

 const input=$('playerNameInput');

 const name=input.value.trim().replace(/\s+/g,' ').slice(0,20);

 if(!name){$('saveScoreStatus').textContent='Please enter your name first.';input.focus();return;}

 if(!db){$('saveScoreStatus').textContent='Leaderboard connection is unavailable. Check the Supabase setup.';return;}

 scoreSaving=true;$('saveScoreBtn').disabled=true;$('saveScoreBtn').textContent='SAVING...';

 $('saveScoreStatus').textContent='Submitting your final score...';

 try{

  const {error}=await db.from(LEADERBOARD_TABLE).insert({player_name:name,score:Math.max(0,Math.floor(finalScore))});

  if(error)throw error;

  scoreSubmitted=true;$('saveScoreBox').classList.remove('show');

  $('panelText').textContent='✅ Score saved for '+name+'! Score: '+Math.floor(finalScore)+'. Coins collected this run: '+coinCount+'.';

  $('saveScoreBtn').textContent='SCORE SAVED ✓';

 }catch(err){

  console.error(err);

 $('saveScoreStatus').textContent='Save failed: '+(error?.message||String(error));

  $('saveScoreBtn').textContent='TRY AGAIN';

 }finally{scoreSaving=false;$('saveScoreBtn').disabled=scoreSubmitted;}

}

async function showGlobalLeaderboard(){

 const screen=$('globalTop10Screen'),rows=$('globalTop10Rows'),status=$('globalTop10Status');

 screen.style.display='block';rows.innerHTML='';status.textContent='Loading global rankings...';

 const cards=screen.querySelectorAll('.lb-podium-card');

 cards.forEach((c,i)=>{c.querySelector('.lb-name').textContent='Loading...';c.querySelector('.lb-score').textContent='—';c.querySelector('.lb-avatar').textContent=avatars[[1,0,2][i]];});

 try{

  if(!db)throw new Error('Supabase client unavailable');

  const {data,error}=await db.from(LEADERBOARD_TABLE).select('player_name,score').order('score',{ascending:false}).limit(10);

  if(error)throw error;

  if(!data?.length){cards.forEach(c=>{c.querySelector('.lb-name').textContent='Waiting...';c.querySelector('.lb-score').textContent='—';});status.textContent='No scores yet. Be the first to play!';return;}

  [1,0,2].forEach((index,pos)=>{

   const c=cards[pos],p=data[index];

   if(!p){c.querySelector('.lb-name').textContent='Waiting...';c.querySelector('.lb-score').textContent='—';c.querySelector('.lb-avatar').textContent='👤';return;}

   c.querySelector('.lb-name').textContent=p.player_name||'Player';

   c.querySelector('.lb-score').textContent=Number(p.score||0).toLocaleString();

   c.querySelector('.lb-avatar').textContent=avatars[index];

  });

  data.forEach((p,i)=>{if(i<3)return;

   const row=document.createElement('div');row.className='lb-row';

   const rank=document.createElement('div');rank.className='lb-rank';rank.textContent=i+1;

   const av=document.createElement('div');av.className='lb-avatar';av.textContent=avatars[i];

   const info=document.createElement('div');info.className='lb-player';

   const name=document.createElement('div');name.className='lb-player-name';name.textContent=p.player_name||'Player';

   const label=document.createElement('div');label.className='lb-player-label';label.textContent='GLOBAL PLAYER';

   info.append(name,label);

   const sc=document.createElement('div');sc.className='lb-row-score';sc.textContent=Number(p.score||0).toLocaleString();

   row.append(rank,av,info,sc);rows.appendChild(row);

  });

  status.textContent='Showing the world’s Top '+data.length+' players';

 }catch(err){console.error(err);status.textContent='Could not load scores. Check Supabase table permissions and internet connection.';}

}

/* Persistent coin wallet: independent of score. */

const BALL_SHOP_ITEMS=[

 {id:'chrome',name:'Silver Phantom',price:20,color:'#cbd5e1',effect:'Quick rebound • Silver shine',rarity:'COMMON',power:1,jumpPower:7.1,bounceBoost:1,doubleJump:false,glow:.08},

 {id:'thunder',name:'Thunder Bolt',price:80,color:'#38bdf8',effect:'High jump • Electric trail',rarity:'RARE',power:2,jumpPower:8.7,bounceBoost:1.2,doubleJump:false,glow:.3},

 {id:'inferno',name:'Inferno Beast',price:200,color:'#fb642b',effect:'Power bounce • Lava glow',rarity:'EPIC',power:3,jumpPower:10.2,bounceBoost:1.45,doubleJump:false,glow:.45},

 {id:'galaxy',name:'Galaxy Titan',price:400,color:'#c084fc',effect:'Mega jump • Cosmic effect',rarity:'LEGENDARY',power:4,jumpPower:11.8,bounceBoost:1.7,doubleJump:false,glow:.55},

 {id:'royal',name:'Godspeed Infinity',price:1000,color:'#facc15',effect:'Extreme jump • Double jump',rarity:'MYTHIC',power:5,jumpPower:13.5,bounceBoost:2,doubleJump:true,glow:.7}

];

const BALL_SAVE_KEY='bounceBallShopSave_v2';

let ballShopSave={coins:0,unlocked:['chrome'],equipped:'chrome'};

function loadBallShopSave(){

 try{

  const old=JSON.parse(localStorage.getItem('bounceBallShopSave_v1')||'null');

  const s=JSON.parse(localStorage.getItem(BALL_SAVE_KEY)||'null')||old;

  if(s){ballShopSave.coins=Math.max(0,Number(s.coins)||0);

   ballShopSave.unlocked=Array.isArray(s.unlocked)?[...new Set(['chrome',...s.unlocked.filter(id=>BALL_SHOP_ITEMS.some(b=>b.id===id))])]:['chrome'];

   ballShopSave.equipped=ballShopSave.unlocked.includes(s.equipped)?s.equipped:'chrome';}

 }catch(e){}

}

function saveBallShopSave(){try{localStorage.setItem(BALL_SAVE_KEY,JSON.stringify(ballShopSave));}catch(e){}}

function updateBallWallet(){if($('walletCoins'))$('walletCoins').textContent=ballShopSave.coins.toLocaleString();}

function renderBallShop(){

 const c=$('ballShopItems');c.innerHTML='';

 BALL_SHOP_ITEMS.forEach(item=>{

  const owned=ballShopSave.unlocked.includes(item.id),equipped=ballShopSave.equipped===item.id,afford=ballShopSave.coins>=item.price;

  const card=document.createElement('div');card.className='ball-shop-card';

  const preview=document.createElement('div');preview.className='shop-ball-preview';

  preview.style.background=`radial-gradient(circle at 30% 25%,#fff 0%,${item.color} 25%,#111827 100%)`;

  preview.style.boxShadow=`0 0 ${8+item.power*5}px ${item.color}`;

  const info=document.createElement('div');info.className='shop-ball-info';

  const rarity=document.createElement('div');rarity.className='shop-rarity';rarity.textContent=item.rarity;

  const title=document.createElement('h3');title.textContent=item.name;

  const effect=document.createElement('p');effect.textContent=item.effect;

  const power=document.createElement('div');power.className='shop-power';power.textContent='★'.repeat(item.power)+'☆'.repeat(5-item.power);

  const price=document.createElement('div');price.className='shop-price';price.textContent='🪙 '+item.price.toLocaleString()+' coins';

  const btn=document.createElement('button');btn.className='shop-action';

  btn.textContent=equipped?'EQUIPPED':owned?'EQUIP BALL':afford?'BUY WITH COINS':'NOT ENOUGH COINS';

  btn.disabled=equipped||(!owned&&!afford);

  btn.addEventListener('click',()=>owned?equipShopBall(item.id):buyShopBall(item.id));

  info.append(rarity,title,effect,power,price,btn);card.append(preview,info);c.appendChild(card);

 });

 updateBallWallet();

}

function openBallShop(){$('message').classList.add('hidden');$('ballShopPanel').classList.remove('hidden');renderBallShop();}

function closeBallShop(){$('ballShopPanel').classList.add('hidden');$('message').classList.remove('hidden');}

function buyShopBall(id){

 const item=BALL_SHOP_ITEMS.find(b=>b.id===id);

 if(!item||ballShopSave.unlocked.includes(id)||ballShopSave.coins<item.price)return;

 ballShopSave.coins-=item.price;ballShopSave.unlocked.push(id);ballShopSave.equipped=id;

 saveBallShopSave();applyEquippedBall();renderBallShop();tone(880,.14,'triangle',.06);

}

