.first .lb-avatar{width:50px;height:50px;font-size:30px}

.lb-place{color:#ffd778;font-weight:900;font-size:11px}.lb-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;font-weight:bold}.lb-score{margin-top:5px;color:#ffd778;font-weight:900;font-size:12px}

