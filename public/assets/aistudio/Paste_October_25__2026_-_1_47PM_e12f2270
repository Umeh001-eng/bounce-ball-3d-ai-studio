function tone(freq,duration=.1,type='sine',volume=.04,delay=0){

 if(!soundOn)return;

 try{

  if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();

  const t=audioCtx.currentTime+delay,o=audioCtx.createOscillator(),g=audioCtx.createGain();

  o.type=type;o.frequency.setValueAtTime(freq,t);

  g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(.0002,volume),t+.012);

  g.gain.exponentialRampToValueAtTime(.0001,t+duration);

  o.connect(g);g.connect(audioCtx.destination);o.start(t);o.stop(t+duration+.02);

 }catch(e){}

}

function kick(){

 if(!soundOn||!audioCtx)return;

 try{

  const t=audioCtx.currentTime,o=audioCtx.createOscillator(),g=audioCtx.createGain();

  o.type='sine';o.frequency.setValueAtTime(125,t);o.frequency.exponentialRampToValueAtTime(42,t+.12);

  g.gain.setValueAtTime(.22,t);g.gain.exponentialRampToValueAtTime(.001,t+.16);

  o.connect(g);g.connect(audioCtx.destination);o.start(t);o.stop(t+.17);

 }catch(e){}

}

function snare(){

 if(!soundOn||!audioCtx)return;

 try{

  const t=audioCtx.currentTime,n=Math.floor(audioCtx.sampleRate*.12),buffer=audioCtx.createBuffer(1,n,audioCtx.sampleRate),d=buffer.getChannelData(0);

  for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);

  const src=audioCtx.createBufferSource(),g=audioCtx.createGain();src.buffer=buffer;

  g.gain.setValueAtTime(.075,t);g.gain.exponentialRampToValueAtTime(.001,t+.12);

  src.connect(g);g.connect(audioCtx.destination);src.start(t);

 }catch(e){}

}

