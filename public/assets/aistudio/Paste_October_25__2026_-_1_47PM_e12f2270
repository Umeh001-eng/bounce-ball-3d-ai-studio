.lb-close{width:100%;margin-top:16px;padding:13px;border:1px solid #f2ce71;border-radius:12px;color:#111827;font-weight:900;background:linear-gradient(100deg,#ffe7a0,#c38a22)}

.lb-status{margin:12px 0;color:#9fc9ff;text-align:center;font-size:12px}

@media(max-height:650px){.panel{padding:12px}.panel h1{font-size:23px}#ballShopCard{max-height:98%;padding:7px}.shop-ball-preview{width:40px;height:40px}.ball-shop-card{padding:6px 4px}}

