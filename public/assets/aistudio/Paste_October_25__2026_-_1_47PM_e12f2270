function update(dt){

 if(!running)return;dt=Math.min(dt,.035);

 damageCooldown=Math.max(0,damageCooldown-dt);invulnerable=Math.max(0,invulnerable-dt);

 recoveryMessageTime=Math.max(0,recoveryMessageTime-dt);

 shieldTime=Math.max(0,shieldTime-dt);speedBoostTime=Math.max(0,speedBoostTime-dt);magnetTime=Math.max(0,magnetTime-dt);

 if(shieldTime<=0)shieldActive=false;updatePowerStatus();

 if(recoveryMessageTime<=0)$('reviveHint').classList.add('hidden');

 if(!tiltOn){if(leftHeld)targetX-=8*dt;if(rightHeld)targetX+=8*dt;}

 targetX=THREE.MathUtils.clamp(targetX,-4.35,4.35);

 ball.position.x+=(targetX-ball.position.x)*Math.min(1,dt*13);

 if(jumping){

  ball.position.y+=jumpVelocity*dt;jumpVelocity-=19*dt;

  if(ball.position.y<=R&&jumpVelocity<0){ball.position.y=R;jumping=false;jumpVelocity=0;airJumpUsed=false;landingBounce=1;}

 }else if(landingBounce>0){

  landingBounce=Math.max(0,landingBounce-dt*3.7);

  ball.position.y=R+Math.max(0,Math.sin((1-landingBounce)*Math.PI))*.22*getEquippedBall().bounceBoost;

 }else ball.position.y=R+Math.abs(Math.sin(performance.now()*.012))*.025;

 if(jumping){const v=Math.min(1,Math.abs(jumpVelocity)/7.1);ball.scale.set(1+.08*v,1-.1*v,1+.08*v);}

 else ball.scale.lerp(new THREE.Vector3(1,1,1),Math.min(1,dt*10));

 if(ball.userData.shadow){

  const sh=ball.userData.shadow,h=Math.max(0,ball.position.y-R),j=Math.min(h/2,1);

  sh.position.x=ball.position.x;sh.position.z=ball.position.z;sh.material.opacity=.28-j*.2;sh.scale.setScalar(1+j*.45);sh.scale.y=.34*(1+j*.45);

 }

 ball.rotation.x-=speed*dt;ball.rotation.z=THREE.MathUtils.clamp((targetX-ball.position.x)*-.18,-.35,.35);

 ballTrail.forEach((p,i)=>{

  const active=getEquippedBall().power>=2||jumping;p.visible=active;

  if(active){p.position.set(ball.position.x,ball.position.y,ball.position.z+.35+i*.22);p.material.opacity=(1-(i+1)/ballTrail.length)*.5;}else p.material.opacity=0;

 });

 ball.visible=invulnerable<=0||Math.floor(performance.now()/160)%2===0;

 speed=Math.min(24,13+distance*.0025)*(speedBoostTime>0?1.22:1);distance+=speed*dt;

 score=Math.floor(distance*2)+coinCount*25;

 roads.forEach(seg=>{seg.position.z+=speed*dt;if(seg.position.z>42)seg.position.z=Math.min(...roads.map(o=>o.position.z))-42;});

 buildings.forEach(b=>{b.group.position.z+=speed*dt;if(b.group.position.z>24)b.group.position.z-=462;});

 palms.forEach(g=>{g.position.z+=speed*dt;if(g.position.z>22)g.position.z-=340;});

 lamps.forEach(g=>{g.position.z+=speed*dt;if(g.position.z>20)g.position.z-=252;});

 const activeCount=distance<180?1:2;

 enemies.forEach((e,i)=>{

  if(i>=activeCount){e.active=false;e.group.visible=false;return;}

  if(!e.active){e.active=true;e.group.visible=true;e.lane=Math.floor(Math.random()*3);e.group.position.set(LANES[e.lane],0,-88-Math.random()*16);e.hasChosenAttack=false;e.steerTimer=1;}

  e.steerTimer-=dt;const ahead=-e.group.position.z+ball.position.z;

  if(e.steerTimer<=0&&ahead>14&&ahead<46&&!e.hasChosenAttack){

   const pl=THREE.MathUtils.clamp(Math.round((ball.position.x-LANES[0])/3.25),0,2),diff=pl-e.lane;

   if(diff!==0&&Math.random()<.45)e.lane+=Math.sign(diff);

   else if(Math.random()<.2)e.lane=THREE.MathUtils.clamp(e.lane+(Math.random()<.5?-1:1),0,2);

   e.hasChosenAttack=true;e.steerTimer=3.5;

  }

  e.group.position.x+=THREE.MathUtils.clamp(LANES[e.lane]-e.group.position.x,-1.15*dt,1.15*dt);

  const es=speed*.65+.4;e.group.position.z+=es*dt;e.group.rotation.x-=es*dt;

  if(Math.abs(e.group.position.z-ball.position.z)<.76&&Math.abs(e.group.position.x-ball.position.x)<.59&&ball.position.y<R+.52&&e.cooldown<=0&&invulnerable<=0){

   if(shieldActive){shieldActive=false;shieldTime=0;}else loseLife(true);

   e.group.position.z=-88-Math.random()*16;e.lane=Math.floor(Math.random()*3);e.group.position.x=LANES[e.lane];e.cooldown=3;e.hasChosenAttack=false;

  }

  e.cooldown=Math.max(0,e.cooldown-dt);

  if(e.group.position.z>8){e.group.position.z=-88-Math.random()*20;e.lane=Math.floor(Math.random()*3);e.group.position.x=LANES[e.lane];e.hasChosenAttack=false;}

 });

 waves.forEach(w=>{

  w.group.position.z+=speed*dt;

  if(!w.hit&&Math.abs(w.group.position.z-ball.position.z)<1){

   for(const b of w.barriers){

    const overlap=Math.abs(ball.position.x-b.position.x)<b.userData.width/2+R*.55,bb=ball.position.y-R;

    if(overlap&&bb<b.userData.height+.1&&invulnerable<=0){

     if(shieldActive){shieldActive=false;shieldTime=0;}else loseLife(false);

     w.hit=true;w.group.position.z=6;break;

    }

   }

  }

  if(w.group.position.z>10){const far=Math.min(...waves.map(o=>o.group.position.z));placeWave(w,far-19,w.index+3);}

 });

 powerUps.forEach(p=>{

  const g=p.group;g.position.z+=speed*dt;g.position.y=.08+Math.sin(performance.now()*.004+p.phase)*.1;g.rotation.y+=dt*1.8;

  if(Math.abs(g.position.z-ball.position.z)<1.15&&Math.abs(g.position.x-ball.position.x)<.95&&Math.abs(ball.position.y-.65)<1.5){

   activatePower(p.type);p.type=['shield','speed','magnet'][Math.floor(Math.random()*3)];g.position.set(LANES[Math.floor(Math.random()*3)],0,-190-Math.random()*45);

  }

  if(g.position.z>7){p.type=['shield','speed','magnet'][Math.floor(Math.random()*3)];g.position.set(LANES[Math.floor(Math.random()*3)],0,-190-Math.random()*45);}

 });

 coins.forEach(c=>{

  const m=c.mesh;m.position.z+=speed*dt;m.rotation.y+=dt*3.2;

  if(magnetTime>0&&!c.taken&&Math.abs(m.position.z-ball.position.z)<5&&Math.abs(m.position.x-ball.position.x)<4){

   m.position.x+=(ball.position.x-m.position.x)*Math.min(1,dt*4.5);

   m.position.z+=(ball.position.z-m.position.z)*Math.min(1,dt*4.5);

  }

  if(!c.taken&&Math.abs(m.position.z-ball.position.z)<1.05&&Math.abs(m.position.x-ball.position.x)<.82&&Math.abs(ball.position.y-.62)<1.65)collectCoin(c);

  if(m.position.z>7){m.position.z=-155-Math.random()*25;m.position.x=LANES[Math.floor(Math.random()*3)];c.taken=false;m.visible=true;}

 });

 camera.position.x+=(ball.position.x*.35-camera.position.x)*Math.min(1,dt*3);

 camera.lookAt(ball.position.x*.18,1.1,-12);updateHUD();

}

function animate(){

 requestAnimationFrame(animate);

 const now=performance.now(),dt=Math.min((now-lastTime)/1000||0,.04);lastTime=now;

 if(running)update(dt);

 renderer.render(scene,camera);

}

function bindHold(id,which){

 const el=$(id);

 const down=e=>{e.preventDefault();if(tiltOn)return;if(which==='left')leftHeld=true;else rightHeld=true;el.classList.add('active');try{el.setPointerCapture(e.pointerId);}catch(err){}};

 const up=()=>{if(which==='left')leftHeld=false;else rightHeld=false;el.classList.remove('active');};

 el.addEventListener('pointerdown',down);el.addEventListener('pointerup',up);el.addEventListener('pointercancel',up);el.addEventListener('lostpointercapture',up);

}

function bindControls(){

 bindHold('leftBtn','left');bindHold('rightBtn','right');

 renderer.domElement.addEventListener('pointerdown',e=>{pointerStart={x:e.clientX,y:e.clientY};lastPointerX=e.clientX;});

 renderer.domElement.addEventListener('pointermove',e=>{

  if(!pointerStart||!running||tiltOn)return;

  const dx=e.clientX-lastPointerX;

  if(Math.abs(dx)>0){targetX=THREE.MathUtils.clamp(targetX+dx*.018,-4.35,4.35);lastPointerX=e.clientX;}

 });

 renderer.domElement.addEventListener('pointerup',e=>{

  if(pointerStart){

   const dx=e.clientX-pointerStart.x,dy=e.clientY-pointerStart.y;

   if(dy<-35&&Math.abs(dy)>Math.abs(dx)*.7)jump();

   else if(!tiltOn&&Math.abs(dx)>55)targetX=THREE.MathUtils.clamp(targetX+Math.sign(dx)*1.5,-4.35,4.35);

  }

  pointerStart=null;

 });

 renderer.domElement.addEventListener('pointercancel',()=>pointerStart=null);

 window.addEventListener('keydown',e=>{

  if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')leftHeld=true;

  if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')rightHeld=true;

  if(e.key==='ArrowUp'||e.key===' ')jump();

  if(e.key.toLowerCase()==='p')togglePause();

 });

 window.addEventListener('keyup',e=>{

  if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')leftHeld=false;

  if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')rightHeld=false;

 });

 window.addEventListener('blur',()=>{leftHeld=rightHeld=false;});

}

function onTilt(e){

 if(!tiltOn||e.gamma===null||e.gamma===undefined)return;

 orientationSeen=true;

 if(tiltBaseline===null){tiltBaseline=e.gamma;return;}

 const lean=e.gamma-tiltBaseline,adjusted=Math.abs(lean)<2?0:lean-Math.sign(lean)*2;

 targetX=THREE.MathUtils.clamp(adjusted*.28,-4.35,4.35);

}

function setTiltUI(on){

 $('tiltBtn').classList.toggle('tilt-active',on);

 $('tiltBtn').querySelector('.tilt-icon').textContent=on?'📱':'↔';

 $('tiltBtn').querySelector('.tilt-label').textContent=on?'TILT ON':'TILT OFF';

 $('leftBtn').style.opacity=on?'.3':'1';$('rightBtn').style.opacity=on?'.3':'1';

 $('leftBtn').style.pointerEvents=on?'none':'auto';$('rightBtn').style.pointerEvents=on?'none':'auto';

 $('bottomHint').textContent=on?'TILT YOUR PHONE LEFT OR RIGHT • SWIPE UP TO JUMP':'ARROWS OR TILT • SWIPE UP TO JUMP';

}

function disableTilt(){

 tiltOn=false;tiltBaseline=null;window.removeEventListener('deviceorientation',onTilt);

 if(orientationTimeout){clearTimeout(orientationTimeout);orientationTimeout=null;}setTiltUI(false);

}

async function enableTilt(){

 if(tiltOn){disableTilt();return;}

 if(!('DeviceOrientationEvent' in window)){alert('Tilt is not supported here. Use Safari on your iPhone or steer with arrows.');return;}

 try{

  if(typeof DeviceOrientationEvent.requestPermission==='function'){

   const permission=await DeviceOrientationEvent.requestPermission();

   if(permission!=='granted'){alert('Motion permission was not granted.');return;}

  }

  tiltBaseline=null;orientationSeen=false;window.removeEventListener('deviceorientation',onTilt);

  window.addEventListener('deviceorientation',onTilt);tiltOn=true;setTiltUI(true);

  if(orientationTimeout)clearTimeout(orientationTimeout);

  orientationTimeout=setTimeout(()=>{

   if(tiltOn&&!orientationSeen){disableTilt();$('bottomHint').textContent='MOTION UNAVAILABLE • USE ARROWS';alert('No motion data received. Open this game in Safari over HTTPS and allow Motion & Orientation Access.');}

  },2500);

 }catch(e){console.error(e);alert('Could not enable tilt. Open the game in Safari over HTTPS and allow motion access.');}

}


$('startBtn').addEventListener('click', () => {
  if (paused) {
    paused = false;
    running = true;
    $('message').classList.add('hidden');
    $('pauseBtn').textContent = 'Ⅱ PAUSE';
    startAudio();
    lastTime = performance.now();
    return;
  }

  if (gameOver) {
    resetGame();
    showMidgameAd();
    return;
  }

  beginGame();
});


$('saveScoreBtn').addEventListener('click',()=>saveScoreToLeaderboard(score));

$('playerNameInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveScoreToLeaderboard(score);}});

$('pauseBtn').addEventListener('click',togglePause);

$('restartBtn').addEventListener('click',()=>{resetGame();beginGame();});

$('soundBtn').addEventListener('click',()=>{

 soundOn=!soundOn;$('soundBtn').textContent=soundOn?'♫ MUSIC ON':'🔇 SOUND OFF';

 if(!soundOn)stopMusic();else if(running)startAudio();

});

$('tiltBtn').addEventListener('click',enableTilt);

$('ballShopBtn').addEventListener('click',openBallShop);

$('closeBallShopBtn').addEventListener('click',closeBallShop);

$('leaderboardBtn').addEventListener('click',showGlobalLeaderboard);

$('closeLeaderboardBtn').addEventListener('click',()=>{$('globalTop10Screen').style.display='none';});

window.addEventListener('resize',()=>{

 if(!camera||!renderer)return;

 camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();

 renderer.setPixelRatio(Math.min(bdevicePixelRatio||1,1.5));renderer.setSize(innerWidth,innerHeight);

});

init();bindControls();updateHUD();updateBallWallet();animate();

})();

